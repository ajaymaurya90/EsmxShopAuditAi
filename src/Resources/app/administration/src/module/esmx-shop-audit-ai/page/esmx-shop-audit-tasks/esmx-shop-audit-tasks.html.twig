{% block esmx_shop_audit_tasks %}
	<sw-page class="esmx-shop-audit tasks">
		<template #smart-bar-header>
			<h2>{{ $tc('esmx-shop-audit-ai.general.mainMenuItemGeneral') }}</h2>
		</template>

		<template #smart-bar-actions>
			<mt-button size="default" @click="goToDashboard">
				{{ $tc('esmx-shop-audit-ai.navigation.dashboard') }}
			</mt-button>

			<mt-button size="default" @click="goToFindings">
				{{ $tc('esmx-shop-audit-ai.navigation.findings') }}
			</mt-button>

			<mt-button variant="primary" size="default">
				{{ $tc('esmx-shop-audit-ai.navigation.tasks') }}
			</mt-button>

			<mt-button size="default" @click="goToReports">
				{{ $tc('esmx-shop-audit-ai.navigation.reports') }}
			</mt-button>

			{#  <mt-button
						                    variant="primary"
						                    size="default"
						                    :disabled="isLoading || isRunningScan"
						                    @click="loadPageData"
						            >
						                {{ $tc('esmx-shop-audit-ai.general.refresh') }}
						            </mt-button>#}

			<div class="esmx-shop-audit__page-actions">
				<div class="dashboard__scan-split-button">
					<mt-button variant="primary" size="default" :loading="isRunningScan" :disabled="isRunningScan" @click="runScan">
						<span v-if="isRunningScan" class="esmx-shop-audit__scan-status">
							{{ $tc('esmx-shop-audit-ai.dashboard.scanRunning') }}
						</span>
						<span v-else>
							{{ $tc('esmx-shop-audit-ai.dashboard.scanStart') }}
						</span>
					</mt-button>

					<mt-button class="dashboard__scan-options-button" variant="primary" size="default" :disabled="isRunningScan" :title="$tc('esmx-shop-audit-ai.dashboard.scanOptions.openButton')" @click="openScanOptionsModal">
						<mt-icon name="regular-chevron-down-s" size="16px"/>
					</mt-button>
				</div>
			</div>
		</template>

		<template #content>
			<sw-card-view class="esmx-shop-audit__page-view">
				<template v-if="loadError">
					<mt-banner variant="danger">
						{{ loadError }}
					</mt-banner>
				</template>

				<template v-if="scanError">
					<mt-banner variant="danger">
						{{ scanError }}
					</mt-banner>
				</template>

				<mt-card class="esmx-shop-audit__overview-card" position-identifier="tasks-overview-card">
					<div class="esmx-shop-audit__section-header">
						<div class="esmx-shop-audit__section-title">
							{{ $tc('esmx-shop-audit-ai.tasks.overviewTitle') }}
						</div>

						<div class="esmx-shop-audit__section-header-meta">
							<div v-if="formattedLatestScanDate" class="esmx-shop-audit__section-subtitle">
								{{ $tc('esmx-shop-audit-ai.dashboard.lastScanLabel') }}:
								{{ formattedLatestScanDate }}
							</div>

							<span class="esmx-shop-audit__info-trigger" @mouseenter="activeWidgetTooltip = 'taskOverview'" @mouseleave="activeWidgetTooltip = null">
								<mt-icon name="regular-info-circle" size="16px" class="esmx-shop-audit__info-icon"/>

								<span v-if="activeWidgetTooltip === 'taskOverview'" class="esmx-shop-audit__tooltip">
									{{ $tc('esmx-shop-audit-ai.tasks.overviewTooltip') }}
								</span>
							</span>
						</div>
					</div>

					<div class="esmx-shop-audit__stats-strip">
						<div class="esmx-shop-audit__stat-item">
							<div class="esmx-shop-audit__stat-label">{{ $tc('esmx-shop-audit-ai.tasks.stats.totalTasks') }}</div>
							<div class="esmx-shop-audit__stat-value">{{ totalTasks }}</div>
						</div>

						<div class="esmx-shop-audit__stat-item">
							<div class="esmx-shop-audit__stat-label">{{ $tc('esmx-shop-audit-ai.tasks.stats.openTasks') }}</div>
							<div class="esmx-shop-audit__stat-value">{{ openTaskCount }}</div>
						</div>

						<div class="esmx-shop-audit__stat-item">
							<div class="esmx-shop-audit__stat-label">{{ $tc('esmx-shop-audit-ai.tasks.stats.highPriority') }}</div>
							<div class="esmx-shop-audit__stat-value">{{ highPriorityTaskCount }}</div>
						</div>

						<div class="esmx-shop-audit__stat-item">
							<div class="esmx-shop-audit__stat-label">{{ $tc('esmx-shop-audit-ai.tasks.stats.mediumPriority') }}</div>
							<div class="esmx-shop-audit__stat-value">{{ mediumPriorityTaskCount }}</div>
						</div>

						<div class="esmx-shop-audit__stat-item">
							<div class="esmx-shop-audit__stat-label">{{ $tc('esmx-shop-audit-ai.tasks.stats.resolved') }}</div>
							<div class="esmx-shop-audit__stat-value">{{ resolvedTaskCount }}</div>
						</div>

						<div class="esmx-shop-audit__stat-item">
							<div class="esmx-shop-audit__stat-label">{{ $tc('esmx-shop-audit-ai.tasks.stats.totalAffected') }}</div>
							<div class="esmx-shop-audit__stat-value">{{ totalAffectedCount }}</div>
						</div>
					</div>
				</mt-card>

				<mt-card class="esmx-shop-audit__table-card" position-identifier="tasks-table-card">
					<template #headline>
						{{ $tc('esmx-shop-audit-ai.tasks.gridHeadline') }}
					</template>

					<div class="esmx-shop-audit__table-topbar">
						<div class="esmx-shop-audit__table-meta">
							{{ $tc('esmx-shop-audit-ai.tasks.showingTasksPrefix') }}
							<strong>{{ processedTasks.length }}</strong>
							{{ $tc('esmx-shop-audit-ai.tasks.showingTasksSuffix') }}
						</div>

						<div class="esmx-shop-audit__filters-toolbar">
							<div class="esmx-shop-audit__filter-dropdown-wrapper">
								<button type="button" class="esmx-shop-audit__filter-dropdown-trigger" @click="togglePriorityFilterMenu">
									<mt-icon name="regular-filter" size="16px"/>
									<span>{{ $tc('esmx-shop-audit-ai.tasks.columns.priority') }}</span>

									<span v-if="selectedPriorityFilters.length" class="esmx-shop-audit__filter-count">
										{{ selectedPriorityFilters.length }}
									</span>
								</button>

								<div v-if="isPriorityFilterMenuOpen" class="esmx-shop-audit__filter-dropdown-menu">
									<label v-for="filter in priorityFilters" :key="filter.key" class="esmx-shop-audit__filter-option" :class="{ 'is-disabled': filter.disabled }">
										<input type="checkbox" :checked="isPrioritySelected(filter.key)" :disabled="filter.disabled" @change="togglePriorityFilter(filter.key)">
										<span>{{ filter.label }}
											({{ filter.count }})</span>
									</label>
								</div>
							</div>

							<div class="esmx-shop-audit__filter-dropdown-wrapper">
								<button type="button" class="esmx-shop-audit__filter-dropdown-trigger" @click="toggleStatusFilterMenu">
									<mt-icon name="regular-filter" size="16px"/>
									<span>{{ $tc('esmx-shop-audit-ai.tasks.columns.status') }}</span>

									<span v-if="selectedStatusFilters.length" class="esmx-shop-audit__filter-count">
										{{ selectedStatusFilters.length }}
									</span>
								</button>

								<div v-if="isStatusFilterMenuOpen" class="esmx-shop-audit__filter-dropdown-menu">
									<label v-for="filter in statusFilters" :key="filter.key" class="esmx-shop-audit__filter-option" :class="{ 'is-disabled': filter.disabled }">
										<input type="checkbox" :checked="isStatusSelected(filter.key)" :disabled="filter.disabled" @change="toggleStatusFilter(filter.key)">
										<span>{{ filter.label }}
											({{ filter.count }})</span>
									</label>
								</div>
							</div>

							<button type="button" class="esmx-shop-audit__clear-filter-button" :disabled="!hasActiveInlineFilters" @click="clearFilters">
								<mt-icon name="regular-times-s" size="16px"/>
							</button>
						</div>
					</div>

					<div v-if="activePriorityFilter || activeCodeFilter" class="esmx-shop-audit__active-filters">
						<p v-if="activePriorityFilter">
							{{ $tc('esmx-shop-audit-ai.tasks.columns.priority') }}:
							<strong>{{ activePriorityFilter }}</strong>
						</p>

						<p v-if="activePriorityFilter">
							{{ $tc('esmx-shop-audit-ai.tasks.columns.priority') }}:
							<strong>{{ getPriorityLabel(activePriorityFilter) }}</strong>
						</p>
					</div>

					<template v-if="processedTasks.length">
						<div class="tasks__table">
							<div class="tasks__table-header">
								<button type="button" class="tasks__header-button tasks__col tasks__col--title" @click="onSortColumn({ property: 'title' })">
									<span>{{ $tc('esmx-shop-audit-ai.tasks.columns.title') }}</span>
									<mt-icon v-if="sortBy === 'title'" :name="sortIconMap[sortDirection]" size="16px"/>
								</button>

								<button type="button" class="tasks__header-button tasks__col tasks__col--priority" @click="onSortColumn({ property: 'priority' })">
									<span>{{ $tc('esmx-shop-audit-ai.tasks.columns.priority') }}</span>
									<mt-icon v-if="sortBy === 'priority'" :name="sortIconMap[sortDirection]" size="16px"/>
								</button>

								<button type="button" class="tasks__header-button tasks__col tasks__col--affected" @click="onSortColumn({ property: 'affectedCount' })">
									<span>{{ $tc('esmx-shop-audit-ai.tasks.columns.affectedCount') }}</span>
									<mt-icon v-if="sortBy === 'affectedCount'" :name="sortIconMap[sortDirection]" size="16px"/>
								</button>

								<button type="button" class="tasks__header-button tasks__col tasks__col--impact" @click="onSortColumn({ property: 'impactScore' })">
									<span>{{ $tc('esmx-shop-audit-ai.tasks.columns.impact') }}</span>
									<mt-icon v-if="sortBy === 'impactScore'" :name="sortIconMap[sortDirection]" size="16px"/>
								</button>

								<button type="button" class="tasks__header-button tasks__col tasks__col--status" @click="onSortColumn({ property: 'status' })">
									<span>{{ $tc('esmx-shop-audit-ai.tasks.columns.status') }}</span>
									<mt-icon v-if="sortBy === 'status'" :name="sortIconMap[sortDirection]" size="16px"/>
								</button>
							</div>

							<div class="tasks__table-body">
								<div v-for="task in processedTasks" :key="task.id" class="tasks__table-row" :class="{ 'is-selected': isTaskSelected(task) }" @click="onTaskClick(task)">
									<div class="tasks__col tasks__col--title">
										<div class="tasks__row-label">
											{{ $tc('esmx-shop-audit-ai.tasks.columns.title') }}
										</div>
										<div class="tasks__title-main">
											{{ getDynamicTaskTitle(task) }}
										</div>
										<div class="tasks__title-code">
											{{ task.code }}
										</div>
									</div>

									<div class="tasks__col tasks__col--priority">
										<div class="tasks__row-label">
											{{ $tc('esmx-shop-audit-ai.tasks.columns.priority') }}
										</div>
										<mt-badge :variant="getPriorityVariant(task.priority)">
											{{ getPriorityLabel(task.priority) }}
										</mt-badge>
									</div>

									<div class="tasks__col tasks__col--affected">
										<div class="tasks__row-label">
											{{ $tc('esmx-shop-audit-ai.tasks.columns.affectedCount') }}
										</div>
										<strong>{{ task.affectedCount }}</strong>
									</div>

									<div class="tasks__col tasks__col--impact">
										<div class="tasks__row-label">
											{{ $tc('esmx-shop-audit-ai.tasks.columns.impact') }}
										</div>
										<mt-badge variant="success">
											+{{ task.impactScore || 0 }}
										</mt-badge>
									</div>

									<div class="tasks__col tasks__col--status">
										<div class="tasks__row-label">
											{{ $tc('esmx-shop-audit-ai.tasks.columns.status') }}
										</div>
										<mt-badge :variant="getStatusVariant(task.status)">
											{{ getStatusLabel(task.status) }}
										</mt-badge>
									</div>
								</div>
							</div>
						</div>
					</template>

					<template v-else>
						<p>{{ $tc('esmx-shop-audit-ai.tasks.emptyState') }}</p>
					</template>
				</mt-card>

				<mt-card ref="taskDetailsSection" class="esmx-shop-audit__section-card esmx-shop-audit__task-details-card" position-identifier="task_details_card">
					<template v-if="!selectedTask">
						<div class="esmx-shop-audit__empty-detail-state">
							{{ $tc('esmx-shop-audit-ai.tasks.detailSection.emptyState') }}
						</div>
					</template>

					<template v-else>
						<div class="tasks__detail-heading-row">
							<div class="tasks__detail-title">
								{{ getDynamicTaskTitle(selectedTask) }}
							</div>
							<mt-button v-if="canApplyAutoFixAll" size="small" variant="primary" :disabled="!canApplyAutoFixAll || isApplyingAutoFix" @click="openAutoFixAllModal">
								{{ $tc('esmx-shop-audit-ai.tasks.autoFixAll.openButton') }}
							</mt-button>
						</div>

						<div v-if="isTaskDetailLoading" class="esmx-shop-audit__task-detail-loading">
							{{ $tc('esmx-shop-audit-ai.general.loading') }}
						</div>

						<template v-else-if="detailItems.length">
							<sw-data-grid :data-source="detailItems" :columns="detailColumns" :allow-column-edit="false" :allow-inline-edit="false" :show-selection="false" :show-actions="false">
								<template #column-name="{ item }">
									<div class="esmx-shop-audit__affected-name">
										{{ item.name }}
									</div>
								</template>

								<template #column-entity="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ getCategoryLabel(item.entity) }}
									</div>
								</template>

								<template #column-languagename="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ item.languageName || '-' }}
									</div>
								</template>

								<template #column-source="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ item.source || '-' }}
									</div>
								</template>

								<template #column-status="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ item.status || '-' }}
									</div>
								</template>

								<template #column-url="{ item }">
									<button type="button" class="tasks__broken-link-url" @click="openBrokenLinkUrl(item)">
										{{ item.url || '-' }}
									</button>
								</template>

								<template #column-identifier="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ item.identifier || '-' }}
									</div>
								</template>

								<template #column-seoscore="{ item }">
									<div class="esmx-shop-audit__task-number-cell">
										<div class="esmx-shop-audit__seo-score-badge" :class="getSeoScoreClass(item.seoScore)">
											{{ formatSeoScore(item.seoScore) }}
										</div>
									</div>
								</template>

								<template #column-severity="{ item }">
									<div class="esmx-shop-audit__severity-badge" :class="getSeoSeverityClass(item.seoScore)">
										{{ getSeoSeverityLabel(item.seoScore) }}
									</div>
								</template>

								<template #column-reason="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										<div class="esmx-shop-audit__reason-pill">
											{{ getReasonLabel(item) }}
										</div>
									</div>
								</template>

								<template #column-currentvalue="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ item.currentValue || '-' }}
									</div>
								</template>

								<template #column-cartvalue="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ formatMoney(item.cartValue) }}
									</div>
								</template>

								<template #column-productcount="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ item.productCount ?? '-' }}
									</div>
								</template>

								<template #column-lastactivityat="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ formatDate(item.lastActivityAt) }}
									</div>
								</template>

								<template #column-saleschannelname="{ item }">
									<div class="esmx-shop-audit__current-value-cell">
										{{ item.salesChannelName || '-' }}
									</div>
								</template>

								<template #column-actions="{ item }">
									<div class="tasks__action-cell">
										<div class="esmx-shop-audit__row-action-menu-wrapper">
											<button type="button" class="esmx-shop-audit__icon-action-button" :title="$tc('esmx-shop-audit-ai.tasks.detailGrid.actionsMenu')" @click.stop="toggleDetailActionMenu(item.id)">
												<mt-icon name="regular-ellipsis-h" size="16px"/>
											</button>

											<div v-if="activeDetailActionMenuId === item.id" class="esmx-shop-audit__row-action-menu" @click.stop>
												<button v-if="isBrokenLinkTask && item.url && item.url !== '-'" type="button" class="esmx-shop-audit__row-action-menu-item" @click.stop="openBrokenLinkUrl(item)">
													{{ $tc('esmx-shop-audit-ai.findings.openBrokenLink') }}
												</button>

												<button v-if="isBrokenLinkTask && item.sourceEntityId && (item.entity === 'product' || item.entity === 'category' || item.entity === 'cms_page')" type="button" class="esmx-shop-audit__row-action-menu-item" @click.stop="openAffectedEntityInNewTab(item)">
													{{ $tc('esmx-shop-audit-ai.findings.openAffectedItem') }}
												</button>

												<button v-if="isCustomerAuditTask" type="button" class="esmx-shop-audit__row-action-menu-item" @click.stop="openCustomerDetailInNewTab(item)">
													{{ $tc('esmx-shop-audit-ai.customerAudit.openCustomer') }}
												</button>

												<button v-if="!isBrokenLinkTask && !isCustomerAuditTask" type="button" class="esmx-shop-audit__row-action-menu-item" @click.stop="openManualFix(item)">
													{{ $tc('esmx-shop-audit-ai.tasks.detailGrid.manualFix') }}
												</button>

												<button v-if="!isBrokenLinkTask && !isCustomerAuditTask && item.autoFixSupported" type="button" class="esmx-shop-audit__row-action-menu-item" @click.stop="openAutoFix(item)">
													{{ $tc('esmx-shop-audit-ai.tasks.detailGrid.autoFix') }}
												</button>
											</div>
										</div>
									</div>
								</template>
							</sw-data-grid>
						</template>

						<template v-else>
							<div class="esmx-shop-audit__empty-detail-state">
								{{ $tc('esmx-shop-audit-ai.tasks.detailSection.noAffectedItems') }}
							</div>
						</template>
					</template>
				</mt-card>
			</sw-card-view>

			<sw-modal v-if="isAutoFixModalOpen" :title="$tc('esmx-shop-audit-ai.tasks.autoFix.modalTitle')" @modal-close="closeAutoFixModal">
				<template v-if="autoFixError">
					<mt-banner variant="danger">
						{{ autoFixError }}
					</mt-banner>
				</template>

				<template v-else-if="isAutoFixPreviewLoading">
					<div class="esmx-shop-audit__task-detail-loading">
						{{ $tc('esmx-shop-audit-ai.general.loading') }}
					</div>
				</template>

				<template v-else-if="autoFixPreview">
					<div class="esmx-shop-audit__auto-fix-preview">
						<div class="esmx-shop-audit__auto-fix-preview-row">
							<strong>{{ $tc('esmx-shop-audit-ai.tasks.detailGrid.columns.name') }}:</strong>
							<span>{{ autoFixPreview.itemName }}</span>
						</div>

						<div class="esmx-shop-audit__auto-fix-preview-row">
							<strong>{{ $tc('esmx-shop-audit-ai.general.field') }}:</strong>
							<span>{{ autoFixPreview.fieldLabel }}</span>
						</div>

						<div class="esmx-shop-audit__auto-fix-preview-row">
							<strong>{{ $tc('esmx-shop-audit-ai.general.currentValue') }}:</strong>
							<span>{{ autoFixPreview.currentValue || '-' }}</span>
						</div>

						<div class="esmx-shop-audit__auto-fix-preview-row">
							<strong>{{ $tc('esmx-shop-audit-ai.general.suggestedValue') }}:</strong>
							<span>{{ autoFixPreview.suggestedValue || '-' }}</span>
						</div>
					</div>
				</template>

				<template #modal-footer>
					<mt-button size="small" @click="closeAutoFixModal">
						{{ $tc('esmx-shop-audit-ai.general.cancel') }}
					</mt-button>

					<mt-button variant="primary" size="small" :loading="isApplyingAutoFix" :disabled="!autoFixPreview || isApplyingAutoFix || autoFixPreview.willChange === false" @click="applyAutoFix">
						{{ $tc('esmx-shop-audit-ai.tasks.autoFix.confirmButton') }}
					</mt-button>
				</template>
			</sw-modal>

			<sw-modal v-if="isAutoFixAllModalOpen" :title="$tc('esmx-shop-audit-ai.tasks.autoFixAll.modalTitle')" @modal-close="closeAutoFixAllModal">
				<template v-if="autoFixAllError">
					<mt-banner variant="danger">
						{{ autoFixAllError }}
					</mt-banner>
				</template>

				<div class="esmx-shop-audit__auto-fix-preview">
					<div class="esmx-shop-audit__auto-fix-preview-row">
						<strong>{{ $tc('esmx-shop-audit-ai.tasks.detailSection.titlePrefix') }}:</strong>
						<span>{{ getDynamicTaskTitle(selectedTask) }}</span>
					</div>

					<div class="esmx-shop-audit__auto-fix-preview-row">
						<strong>{{ $tc('esmx-shop-audit-ai.tasks.columns.affectedCount') }}:</strong>
						<span>{{ detailItems.length }}</span>
					</div>

					<div class="esmx-shop-audit__auto-fix-preview-row">
						<strong>{{ $tc('esmx-shop-audit-ai.tasks.autoFixAll.whatWillChangeLabel') }}:</strong>
						<span>{{ $tc('esmx-shop-audit-ai.tasks.autoFixAll.whatWillChangeText') }}</span>
					</div>
				</div>

				<template #modal-footer>
					<mt-button size="small" :disabled="isApplyingAutoFix" @click="closeAutoFixAllModal">
						{{ $tc('esmx-shop-audit-ai.general.cancel') }}
					</mt-button>

					<mt-button variant="primary" size="small" :loading="isApplyingAutoFix" :disabled="isApplyingAutoFix || !detailItems.length" @click="confirmAutoFixAll">
						{{ $tc('esmx-shop-audit-ai.tasks.autoFixAll.confirmButton') }}
					</mt-button>
				</template>
			</sw-modal>
		</template>
	</sw-page>
{% endblock %}
