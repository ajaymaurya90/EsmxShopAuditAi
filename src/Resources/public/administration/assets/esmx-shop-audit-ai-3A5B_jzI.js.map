{% block esmx_shop_audit_dashboard %}
	<sw-page class="esmx-shop-audit dashboard">

		<template #smart-bar-header>
			<h2>{{ $tc('esmx-shop-audit-ai.general.mainMenuItemGeneral') }}</h2>
		</template>

		<template #smart-bar-actions>
			<mt-button variant="primary" size="default">
				{{ $tc('esmx-shop-audit-ai.navigation.dashboard') }}
			</mt-button>

			<mt-button size="default" @click="goToFindings">
				{{ $tc('esmx-shop-audit-ai.navigation.findings') }}
			</mt-button>

			<mt-button size="default" @click="goToTasks">
				{{ $tc('esmx-shop-audit-ai.navigation.tasks') }}
			</mt-button>

			<mt-button size="default" @click="goToReports">
				{{ $tc('esmx-shop-audit-ai.navigation.reports') }}
			</mt-button>

			<mt-button size="default" @click="goToSettings">
				{{ $tc('esmx-shop-audit-ai.navigation.settings') }}
			</mt-button>

			<div class="esmx-shop-audit__page-actions">
				<div class="dashboard__scan-split-button">
					<mt-button variant="primary" size="default" :loading="isRunningScan" :disabled="isRunningScan" @click="runScan">
						<span v-if="isRunningScan" class="esmx-shop-audit__scan-status">
							{{ $tc('esmx-shop-audit-ai.dashboard.scanRunning') }}
						</span>
						<span v-else>
							{{ $tc('esmx-shop-audit-ai.dashboard.scanStart') }}
						</span>
					</mt-button>

					<mt-button class="dashboard__scan-options-button" variant="primary" size="default" :disabled="isRunningScan" :title="$tc('esmx-shop-audit-ai.dashboard.scanOptions.openButton')" @click="openScanOptionsModal">
						<mt-icon name="regular-chevron-down-s" size="16px"/>
					</mt-button>
				</div>
			</div>
		</template>

		<template #content>
			<sw-card-view class="esmx-shop-audit__page-view">
				<template v-if="loadError">
					<mt-banner variant="danger">
						{{ loadError }}
					</mt-banner>
				</template>

				<template v-else-if="hasCompletedScan">
					<template v-if="scanError">
						<mt-banner variant="danger">
							{{ scanError }}
						</mt-banner>
					</template>

					<mt-card class="esmx-shop-audit__overview-card">
						<div class="esmx-shop-audit__section-header">
							<div class="esmx-shop-audit__section-title-stack">
								<div class="esmx-shop-audit__section-title">
									{{ $tc('esmx-shop-audit-ai.dashboard.scanResultsTitle') }}
								</div>

								<div class="esmx-shop-audit__section-subtitle">
									{{ healthSummaryText }}
								</div>
							</div>

							<div class="esmx-shop-audit__section-header-meta">
								<div v-if="formattedLatestScanDate" class="esmx-shop-audit__section-subtitle">
									{{ $tc('esmx-shop-audit-ai.dashboard.lastScanLabel') }}:
									{{ formattedLatestScanDate }}
								</div>

								<span class="esmx-shop-audit__info-trigger" @mouseenter="activeWidgetTooltip = 'scanCriteria'" @mouseleave="activeWidgetTooltip = null">
									<mt-icon name="regular-info-circle" size="16px" class="esmx-shop-audit__info-icon"/>

									<span v-if="activeWidgetTooltip === 'scanCriteria'" class="esmx-shop-audit__tooltip">
										{{ $tc('esmx-shop-audit-ai.dashboard.scanCriteriaInfo') }}
									</span>
								</span>
							</div>
						</div>

						<div class="esmx-shop-audit__stats-strip">
							<div v-for="stat in scanOverviewStats" :key="stat.key" class="esmx-shop-audit__stat-item">
								<div class="esmx-shop-audit__stat-label">
									{{ stat.label }}
								</div>

								<div class="esmx-shop-audit__stat-value">
									{{ stat.value }}
								</div>
							</div>
						</div>

						<div class="dashboard__audit-overview-content">
							<div class="dashboard__store-health-panel">
								<div class="dashboard__widget-header">
									<div class="dashboard__widget-header-text">
										<div class="dashboard__widget-title">
											{{ $tc('esmx-shop-audit-ai.dashboard.storeHealthTitle') }}
										</div>
										<div v-if="hasHealthScore" class="dashboard__widget-subtitle">
											{{ $tc('esmx-shop-audit-ai.dashboard.healthIncludedChecksInfo') }}
										</div>
									</div>

									<span class="esmx-shop-audit__info-trigger" @mouseenter="activeWidgetTooltip = 'storeHealth'" @mouseleave="activeWidgetTooltip = null">
										<mt-icon name="regular-info-circle" size="16px" class="esmx-shop-audit__info-icon"/>

										<span v-if="activeWidgetTooltip === 'storeHealth'" class="esmx-shop-audit__tooltip esmx-shop-audit__tooltip--light">
											<div class="esmx-shop-audit__health-tooltip">
												<strong>{{ $tc('esmx-shop-audit-ai.dashboard.storeHealthFormulaTitle') }}</strong>

												<div v-for="rule in dashboard?.health?.breakdown || []" :key="rule.key" class="esmx-shop-audit__health-tooltip-row">
													<span>{{ getHealthLabel(rule.key) }}</span>
													<span>-{{ rule.penalty }}</span>
												</div>

												<div class="esmx-shop-audit__health-tooltip-total">
													{{ $tc('esmx-shop-audit-ai.dashboard.storeHealthFinalScore') }}:
													{{ hasHealthScore ? healthScore + ' / 100' : healthScoreDisplay }}
												</div>
											</div>
										</span>
									</span>
								</div>

								<div class="dashboard__store-health-layout">
									<div class="dashboard__store-health-score-column">
										<div class="dashboard__health-score-ring" :style="healthRingStyle">
											<div class="dashboard__health-score-ring-inner">
												<div class="dashboard__health-score-value">
													{{ healthScoreDisplay }}
												</div>
												<div v-if="hasHealthScore" class="dashboard__health-score-max">
													/ 100
												</div>
											</div>
										</div>

										<div class="dashboard__store-health-status">
											<span class="esmx-shop-audit__severity-badge" :class="'severity-' + healthStatus">
												{{ healthStatusLabel }}
											</span>
										</div>
									</div>

									<div class="dashboard__store-health-action-column">
										<div class="dashboard__quick-action-header">
											<div class="dashboard__quick-action-title">
												{{ $tc('esmx-shop-audit-ai.dashboard.nextBestActionTitle') }}
											</div>
										</div>

										<div v-if="nextBestAction" class="dashboard__quick-action-body">
											<div class="dashboard__quick-action-label">
												{{ nextBestAction.label }}
											</div>

											<div class="dashboard__quick-action-summary">
												{{ dashboardHeadline }}
											</div>

											<div class="dashboard__quick-action-footer">
												<mt-button size="small" variant="primary" @click="handleNextBestAction">
													{{ $tc('esmx-shop-audit-ai.dashboard.reviewNow') }}
												</mt-button>
											</div>
										</div>

										<div v-else class="dashboard__quick-action-body">
											<div class="dashboard__quick-action-label">
												{{ hasHealthScore
                                                    ? $tc('esmx-shop-audit-ai.dashboard.healthyHeadline')
                                                    : $tc('esmx-shop-audit-ai.dashboard.healthNoChecksAction') }}
											</div>

											<div class="dashboard__quick-action-summary">
												{{ healthSummaryText }}
											</div>
										</div>
									</div>
								</div>
							</div>

							<div class="dashboard__top-tasks-panel">
								<div class="dashboard__widget-header">
									<div class="dashboard__widget-header-text">
										<div class="dashboard__widget-title">
											{{ $tc('esmx-shop-audit-ai.dashboardInsights.topTasksHeadline') }}
										</div>
										<div class="dashboard__widget-subtitle">
											{{ $tc('esmx-shop-audit-ai.dashboard.topTasksSubtitle') }}
										</div>
									</div>

									<div class="dashboard__widget-header-actions">
										<span class="esmx-shop-audit__info-trigger" @mouseenter="activeWidgetTooltip = 'topTasks'" @mouseleave="activeWidgetTooltip = null">
											<mt-icon name="regular-info-circle" size="16px" class="esmx-shop-audit__info-icon"/>

											<span v-if="activeWidgetTooltip === 'topTasks'" class="esmx-shop-audit__tooltip">
												{{ $tc('esmx-shop-audit-ai.dashboard.topTasksInfo') }}
											</span>
										</span>

										<mt-button size="small" variant="secondary" @click="goToTasks">
											{{ $tc('esmx-shop-audit-ai.dashboard.viewAll') }}
										</mt-button>
									</div>
								</div>

								<div class="dashboard__widget-body">
									<template v-if="topTasks.length">
										<div v-for="task in topTasks" :key="task.id" class="dashboard__insight-list-item dashboard__insight-list-item--clickable" @click="goToTaskFilter(task)">
											<div>
												<div class="dashboard__insight-title">
													{{ getDynamicTaskTitle(task) }}
												</div>
												<div class="dashboard__insight-meta">
													{{ getPriorityLabel(task.priority) }}
													·
													{{ getStatusLabel(task.status) }}
												</div>
											</div>
											<strong>{{ task.affectedCount }}</strong>
										</div>
									</template>

									<template v-else>
										<p>{{ $tc('esmx-shop-audit-ai.dashboardInsights.emptyTasks') }}</p>
									</template>
								</div>
							</div>
						</div>
					</mt-card>

					<div class="dashboard__sales-section">
						<mt-card class="dashboard__sales-section-card">
							<div class="dashboard__widget-header">
								<div class="dashboard__widget-header-text">
									<div class="dashboard__widget-title">
										{{ $tc('esmx-shop-audit-ai.dashboard.salesInsightsHeadline') }}
									</div>
									<div class="dashboard__widget-subtitle">
										{{ $tc('esmx-shop-audit-ai.dashboard.salesInsightsSubtitle') }}
									</div>
								</div>

								<span class="esmx-shop-audit__info-trigger" @mouseenter="activeWidgetTooltip = 'salesInsights'" @mouseleave="activeWidgetTooltip = null">
									<mt-icon name="regular-info-circle" size="16px" class="esmx-shop-audit__info-icon"/>

									<span v-if="activeWidgetTooltip === 'salesInsights'" class="esmx-shop-audit__tooltip">
										{{ $tc('esmx-shop-audit-ai.dashboard.salesInsightsInfo') }}
									</span>
								</span>
							</div>

							<div class="dashboard__sales-kpis">
								<div class="dashboard__sales-kpi">
									<span>{{ $tc('esmx-shop-audit-ai.dashboard.salesRevenue') }}</span>
									<strong>{{ formatCurrency(salesKpis.revenue) }}</strong>
								</div>

								<div class="dashboard__sales-kpi">
									<span>{{ $tc('esmx-shop-audit-ai.dashboard.salesOrders') }}</span>
									<strong>{{ salesKpis.orders }}</strong>
								</div>

								<div class="dashboard__sales-kpi">
									<span>{{ $tc('esmx-shop-audit-ai.dashboard.salesRevenueChange') }}</span>
									<strong>{{ salesKpis.revenueChange.toFixed(1) }}%</strong>
								</div>

								<div class="dashboard__sales-kpi">
									<span>{{ $tc('esmx-shop-audit-ai.dashboard.salesOrdersChange') }}</span>
									<strong>{{ salesKpis.ordersChange.toFixed(1) }}%</strong>
								</div>
							</div>

							<div class="dashboard__sales-widgets-grid">
								<div class="dashboard__sales-widget">
									<div class="dashboard__widget-header">
										<div class="dashboard__widget-header-text">
											<div class="dashboard__widget-title">
												{{ $tc('esmx-shop-audit-ai.dashboard.topSellingProducts') }}
											</div>
											<div class="dashboard__widget-subtitle">
												{{ $tc('esmx-shop-audit-ai.dashboard.topSellingProductsSubtitle') }}
											</div>
										</div>

										<span class="esmx-shop-audit__info-trigger" @mouseenter="activeWidgetTooltip = 'topSellingProducts'" @mouseleave="activeWidgetTooltip = null">
											<mt-icon name="regular-info-circle" size="16px" class="esmx-shop-audit__info-icon"/>

											<span v-if="activeWidgetTooltip === 'topSellingProducts'" class="esmx-shop-audit__tooltip">
												{{ $tc('esmx-shop-audit-ai.dashboard.topSellingProductsInfo') }}
											</span>
										</span>
									</div>

									<div class="dashboard__widget-body">
										<div v-if="topSellingProducts.length">
											<div v-for="product in topSellingProducts" :key="product.productId" class="dashboard__insight-list-item dashboard__insight-list-item--clickable" @click="goToProductDetail(product.productId)">
												<span>{{ product.name }}</span>
												<strong>{{ product.sales }}</strong>
											</div>
										</div>

										<div v-else>
											{{ $tc('esmx-shop-audit-ai.dashboard.noSalesData') }}
										</div>
									</div>
								</div>

								<div class="dashboard__sales-widget">
									<div class="dashboard__widget-header">
										<div class="dashboard__widget-header-text">
											<div class="dashboard__widget-title">
												{{ $tc('esmx-shop-audit-ai.dashboard.lowStockProducts') }}
											</div>
											<div class="dashboard__widget-subtitle">
												{{ $tc('esmx-shop-audit-ai.dashboard.lowStockProductsSubtitle') }}
											</div>
										</div>

										<span class="esmx-shop-audit__info-trigger" @mouseenter="activeWidgetTooltip = 'lowStockProducts'" @mouseleave="activeWidgetTooltip = null">
											<mt-icon name="regular-info-circle" size="16px" class="esmx-shop-audit__info-icon"/>

											<span v-if="activeWidgetTooltip === 'lowStockProducts'" class="esmx-shop-audit__tooltip">
												{{ $tc('esmx-shop-audit-ai.dashboard.lowStockProductsInfo') }}
											</span>
										</span>
									</div>

									<div class="dashboard__widget-body">
										<div v-if="lowStockProducts.length">
											<div v-for="product in lowStockProducts" :key="product.id" class="dashboard__insight-list-item dashboard__insight-list-item--clickable" @click="goToProductDetail(product.id)">
												<span>{{ product.name }}</span>
												<strong>
													{{ $tc('esmx-shop-audit-ai.dashboard.stockLabel') }}:
													{{ product.stock }}
												</strong>
											</div>
										</div>

										<div v-else>
											{{ $tc('esmx-shop-audit-ai.dashboard.noLowStockProducts') }}
										</div>
									</div>
								</div>
							</div>
						</mt-card>
					</div>

					<mt-card class="dashboard__seo-kpi-card">
						<div class="esmx-shop-audit__section-header">
							<div class="esmx-shop-audit__section-title">
								{{ $tc('esmx-shop-audit-ai.dashboard.seoKpiTitle') }}
							</div>
							<div class="esmx-shop-audit__section-subtitle">
								{{ $tc('esmx-shop-audit-ai.dashboard.seoKpiSubtitle') }}
							</div>
						</div>

						<div v-if="!isSeoIncludedInLatestScan" class="dashboard__seo-disabled-state">
							{{ $tc('esmx-shop-audit-ai.dashboard.seoAuditNotIncluded') }}
						</div>

						<div v-else class="dashboard__seo-kpi-grid">
							<div v-for="card in seoKpiCards" :key="card.key" class="dashboard__seo-kpi-tile">
								<div class="dashboard__seo-kpi-label">
									{{ card.label }}
								</div>

								<div class="dashboard__seo-kpi-value">
									{{ card.value }}
								</div>

								<div class="dashboard__widget-subtitle">
									{{ card.hint }}
								</div>
							</div>
						</div>
					</mt-card>

					<div class="dashboard__summary">
						<div class="dashboard__summary-meta">
							<div class="dashboard__summary-header">
								<div class="dashboard__headline">
									<h3>{{ $tc('esmx-shop-audit-ai.dashboard.issueGroups') }}</h3>
									<p class="dashboard__widget-subtitle">
										{{ $tc('esmx-shop-audit-ai.dashboard.issueGroupsSubtitle') }}
									</p>
									<p class="dashboard__widget-subtitle">
										{{ $tc('esmx-shop-audit-ai.dashboard.scannedProducts') }}:
										<strong>{{ meta.scannedProducts }}</strong>
										·
										{{ $tc('esmx-shop-audit-ai.dashboard.totalIssues') }}:
										<strong>{{ totals.totalIssues }}</strong>
									</p>
								</div>

								<mt-button size="small" variant="secondary" @click="goToFindings">
									{{ $tc('esmx-shop-audit-ai.dashboard.viewAllFindings') }}
								</mt-button>
							</div>
						</div>

						<div v-if="!sortedSummaryCards.length" class="dashboard__summary-empty-state">
							{{ $tc('esmx-shop-audit-ai.dashboard.noActiveIssueGroups') }}
						</div>

						<div v-else class="dashboard__summary-grid">
							<a v-for="card in sortedSummaryCards" :key="card.key" href="#" class="dashboard__metric-card-link" @click.prevent="goToFindingFromCard(card)">
								<mt-card class="dashboard__metric-card" :class="'dashboard__metric-card--' + card.severity">
									<div class="dashboard__metric-card-layout">
										<div class="dashboard__metric-card-count-area" :class="'severity-' + card.severity">
											<span class="dashboard__metric-card-number">
												{{ card.count }}
											</span>
										</div>

										<div class="dashboard__metric-card-details">
											<div class="dashboard__metric-card-title-row">
												<div class="dashboard__metric-card-label">
													{{ card.label }}
												</div>
											</div>

											<div class="dashboard__metric-card-meta-row">
												<span class="esmx-shop-audit__severity-badge" :class="'severity-' + card.severity">
													{{ getSeverityLabel(card.severity) }}
												</span>

												<span class="dashboard__metric-card-info-wrapper" @mouseenter="activeImpactKey = card.key" @mouseleave="activeImpactKey = null">
													<mt-icon name="regular-info-circle" size="16px" class="dashboard__metric-card-info"/>

													<span v-if="activeImpactKey === card.key" class="dashboard__metric-card-tooltip">
														{{ card.impact }}
													</span>
												</span>
											</div>
										</div>
									</div>
								</mt-card>
							</a>
						</div>
					</div>
				</template>

				<template v-else>
					<mt-card>
						<p>{{ $tc('esmx-shop-audit-ai.dashboard.emptyState') }}</p>
					</mt-card>
				</template>
			</sw-card-view>

			<sw-modal v-if="isScanOptionsModalOpen" class="dashboard__scan-options-modal" :title="$tc('esmx-shop-audit-ai.dashboard.scanOptions.configureTitle')" :subtitle="$tc('esmx-shop-audit-ai.dashboard.scanOptions.configureSubtitle')" size="1220px" @modal-close="closeScanOptionsModal">
				<div class="dashboard__scan-options-content">
					<div class="scan-options__intro">
						<div class="scan-options__summary">
							<span class="scan-options__summary-icon" aria-hidden="true"></span>
							<span>{{ scanOptionSummaryText }}</span>
						</div>
					</div>

					<div class="scan-options__groups">
						<section v-for="group in scanOptionGroups" :key="group.key" class="scan-options__group" :class="{
								                                    'is-partial': isScanOptionGroupPartiallyChecked(group.key),
								                                    'is-collapsed': isScanOptionGroupCollapsed(group.key)
								                                }">
							<div class="scan-options__group-header">
								<div class="scan-options__group-title">
									<label class="scan-options__group-label">
										<input class="scan-options__checkbox" :ref="'scanOptionGroupCheckbox-' + group.key" type="checkbox" :checked="isScanOptionGroupFullyChecked(group.key)" :indeterminate.prop="isScanOptionGroupPartiallyChecked(group.key)" @change="onScanOptionGroupToggle(group.key)">

										<span class="scan-options__group-icon" aria-hidden="true">
											<mt-icon :name="getScanOptionGroupIcon(group.key)" size="18px"/>
										</span>

										<span>{{ group.label }}</span>
									</label>

									<span class="scan-options__info" tabindex="0" :aria-label="$tc(getScanOptionGroupTooltipKey(group.key))">
										<mt-icon name="regular-info-circle" size="14px"/>
										<span class="scan-options__tooltip">
											{{ $tc(getScanOptionGroupTooltipKey(group.key)) }}
										</span>
									</span>
								</div>

								<button type="button" class="scan-options__collapse-button" :aria-expanded="!isScanOptionGroupCollapsed(group.key)" @click="toggleScanOptionGroupCollapse(group.key)">
									<mt-icon :name="isScanOptionGroupCollapsed(group.key) ? 'regular-chevron-down-s' : 'regular-chevron-up-s'" size="16px"/>
								</button>
							</div>

							<div v-show="!isScanOptionGroupCollapsed(group.key)" class="scan-options__group-body">
								<div class="scan-options__grid">
									<div v-for="check in group.checks" :key="check.key" class="scan-options__check">
										<label class="scan-options__check-label">
											<input class="scan-options__checkbox" type="checkbox" :checked="scanOptionsDraft[group.key].checks[check.key]" @change="onScanOptionCheckToggle(group.key, check.key, $event)">
											<span>{{ check.label }}</span>
										</label>

										<span class="scan-options__info scan-options__info--check" tabindex="0" :aria-label="$tc(getScanOptionTooltipKey(group.key, check.key))">
											<mt-icon name="regular-info-circle" size="13px"/>
											<span class="scan-options__tooltip">
												{{ $tc(getScanOptionTooltipKey(group.key, check.key)) }}
											</span>
										</span>
									</div>
								</div>
							</div>
						</section>
					</div>
				</div>

				<template #modal-footer>
					<div class="scan-options__footer">
						<mt-button size="small" variant="secondary" :disabled="isRunningScan" @click="selectAllScanOptions">
							{{ $tc('esmx-shop-audit-ai.dashboard.scanOptions.selectAll') }}
						</mt-button>

						<mt-button size="small" variant="secondary" :disabled="isRunningScan" @click="resetScanOptionsDraft">
							{{ $tc('esmx-shop-audit-ai.dashboard.scanOptions.reset') }}
						</mt-button>

						<mt-button size="small" :disabled="isRunningScan" @click="closeScanOptionsModal">
							{{ $tc('esmx-shop-audit-ai.dashboard.scanOptions.cancel') }}
						</mt-button>

						<mt-button variant="primary" size="small" :loading="isRunningScan" :disabled="isRunningScan" @click="saveAndRunScanWithOptions">
							{{ $tc('esmx-shop-audit-ai.dashboard.scanOptions.saveAndRun') }}
						</mt-button>
					</div>
				</template>
			</sw-modal>
		</template>
	</sw-page>
{% endblock %}
