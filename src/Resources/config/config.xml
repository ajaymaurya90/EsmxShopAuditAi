<?xml version="1.0" encoding="UTF-8"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">


    <card>
        <title>General settings</title>
        <title lang="de-DE">Allgemeine Einstellungen</title>

        <input-field type="bool">
            <name>enableAudit</name>
            <label>Enable audit checks</label>
            <label lang="de-DE">Audit-Prüfungen aktivieren</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="int">
            <name>auditProductLimit</name>
            <label>Product audit limit per run</label>
            <label lang="de-DE">Produktlimit pro Audit-Lauf</label>
            <defaultValue>100</defaultValue>
        </input-field>
        <input-field type="single-select">
            <name>variantAuditMode</name>

            <label>Variant audit mode</label>
            <label lang="de-DE">Modus für Variantenprüfung</label>
            <options>
                <option>
                    <id>effective</id>
                    <name>Audit effective storefront data</name>
                    <name lang="de-DE">Effektive Storefront-Daten prüfen</name>
                </option>
                <option>
                    <id>raw</id>
                    <name>Audit raw variant records</name>
                    <name lang="de-DE">Rohe Varianten-Datensätze prüfen</name>
                </option>
            </options>
            <defaultValue>effective</defaultValue>

            <helpText>
                Choose whether the audit should evaluate the effective storefront data inherited from parent products, or strictly check the raw values stored on variant records.
            </helpText>
            <helpText lang="de-DE">
                Wählen Sie, ob das Audit die effektiven Storefront-Daten inklusive Vererbung vom Elternprodukt prüfen soll oder strikt die rohen Werte der Varianten-Datensätze.
            </helpText>
        </input-field>
    </card>

    <card>
        <title>Product Health Audit</title>
        <title lang="de-DE">Produktzustands-Audit</title>

        <input-field type="bool">
            <name>productHealthAuditEnabled</name>
            <label>Enable product health audit</label>
            <label lang="de-DE">Produktzustands-Audit aktivieren</label>
            <defaultValue>true</defaultValue>
        </input-field>
    </card>

    <card>
        <title>SEO Audit</title>
        <title lang="de-DE">SEO-Audit</title>

        <input-field type="bool">
            <name>seoAuditEnabled</name>
            <label>Enable SEO audit</label>
            <label lang="de-DE">SEO-Audit aktivieren</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="int">
            <name>minProductTitleLength</name>
            <label>Minimum product title length</label>
            <label lang="de-DE">Minimale Länge des Produktnamens</label>
            <defaultValue>20</defaultValue>
        </input-field>

        <input-field type="int">
            <name>minProductDescriptionLength</name>
            <label>Minimum product description length</label>
            <label lang="de-DE">Minimale Länge der Produktbeschreibung</label>
            <defaultValue>80</defaultValue>
        </input-field>

        <input-field type="int">
            <name>seoMetaTitleMinLength</name>
            <label>SEO meta title minimum length</label>
            <label lang="de-DE">Minimale Länge des SEO-Meta-Titels</label>
            <defaultValue>30</defaultValue>
        </input-field>

        <input-field type="int">
            <name>seoMetaTitleMaxLength</name>
            <label>SEO meta title maximum length</label>
            <label lang="de-DE">Maximale Länge des SEO-Meta-Titels</label>
            <defaultValue>65</defaultValue>
        </input-field>

        <input-field type="int">
            <name>seoMetaDescriptionMinLength</name>
            <label>SEO meta description minimum length</label>
            <label lang="de-DE">Minimale Länge der SEO-Meta-Beschreibung</label>
            <defaultValue>80</defaultValue>
        </input-field>

        <input-field type="int">
            <name>seoMetaDescriptionMaxLength</name>
            <label>SEO meta description maximum length</label>
            <label lang="de-DE">Maximale Länge der SEO-Meta-Beschreibung</label>
            <defaultValue>160</defaultValue>
        </input-field>

        <input-field type="int">
            <name>seoImprovementThreshold</name>
            <label>SEO improvement threshold</label>
            <label lang="de-DE">SEO-Verbesserungsschwelle</label>
            <defaultValue>70</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Broken Link Audit</title>
        <title lang="de-DE">Broken-Link-Prüfung</title>

        <input-field type="bool">
            <name>brokenLinkAuditEnabled</name>
            <label>Enable broken link detection</label>
            <label lang="de-DE">Broken-Link-Erkennung aktivieren</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>brokenLinkCheckExternal</name>
            <label>Check external links</label>
            <label lang="de-DE">Externe Links prüfen</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="int">
            <name>brokenLinkMaxLinks</name>
            <label>Maximum links per scan</label>
            <label lang="de-DE">Maximale Links pro Scan</label>
            <defaultValue>100</defaultValue>
        </input-field>

        <input-field type="int">
            <name>brokenLinkTimeout</name>
            <label>HTTP request timeout (seconds)</label>
            <label lang="de-DE">HTTP-Timeout (Sekunden)</label>
            <defaultValue>5</defaultValue>
        </input-field>
    </card>
    <card>
        <title>Sales Audit</title>
        <title lang="de-DE">Sales-Audit</title>

        <input-field type="bool">
            <name>salesAuditEnabled</name>
            <label>Enable sales audit</label>
            <label lang="de-DE">Sales-Audit aktivieren</label>
            <defaultValue>true</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Customer Audit</title>
        <title lang="de-DE">Kunden-Audit</title>

        <input-field type="bool">
            <name>customerAuditEnabled</name>
            <label>Enable customer audit</label>
            <label lang="de-DE">Kunden-Audit aktivieren</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="int">
            <name>abandonedCartThresholdMinutes</name>
            <label>Abandoned cart threshold (minutes)</label>
            <label lang="de-DE">Schwelle für abgebrochene Warenkörbe (Minuten)</label>
            <defaultValue>60</defaultValue>
        </input-field>

        <input-field type="float">
            <name>abandonedCartMinValue</name>
            <label>Minimum abandoned cart value</label>
            <label lang="de-DE">Mindestwert für abgebrochene Warenkörbe</label>
            <defaultValue>0</defaultValue>
        </input-field>
    </card>

    <card>
        <title>AI Settings</title>
        <title lang="de-DE">KI-Einstellungen</title>

        <input-field type="bool">
            <name>enableAi</name>
            <label>Enable AI</label>
            <label lang="de-DE">KI aktivieren</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>aiProvider</name>
            <label>AI Provider</label>
            <label lang="de-DE">KI-Anbieter</label>
            <options>
                <option>
                    <id>openai</id>
                    <name>OpenAI</name>
                </option>
                <option>
                    <id>gemini</id>
                    <name>Gemini</name>
                </option>
                <option>
                    <id>claude</id>
                    <name>Claude (future)</name>
                </option>
                <option>
                    <id>azure_openai</id>
                    <name>Azure OpenAI (future)</name>
                </option>
                <option>
                    <id>openai_compatible</id>
                    <name>OpenAI-compatible endpoint (future)</name>
                </option>
            </options>
            <defaultValue>gemini</defaultValue>
        </input-field>

        <input-field type="password">
            <name>openAiApiKey</name>
            <label>OpenAI API Key</label>
            <label lang="de-DE">OpenAI-API-Schlüssel</label>
        </input-field>

        <input-field type="text">
            <name>openAiModel</name>
            <label>OpenAI Model</label>
            <label lang="de-DE">OpenAI-Modell</label>
            <defaultValue>gpt-4.1-mini</defaultValue>
        </input-field>

        <input-field type="text">
            <name>openAiBaseUrl</name>
            <label>OpenAI Base URL</label>
            <label lang="de-DE">OpenAI-Basis-URL</label>
            <defaultValue>https://api.openai.com/v1</defaultValue>
        </input-field>

        <input-field type="password">
            <name>geminiApiKey</name>
            <label>Gemini API Key</label>
            <label lang="de-DE">Gemini-API-Schlüssel</label>
        </input-field>

        <input-field type="text">
            <name>geminiModel</name>
            <label>Gemini Model</label>
            <label lang="de-DE">Gemini-Modell</label>
            <defaultValue>gemini-2.0-flash</defaultValue>
        </input-field>

        <input-field type="text">
            <name>geminiBaseUrl</name>
            <label>Gemini Base URL</label>
            <label lang="de-DE">Gemini-Basis-URL</label>
            <defaultValue>https://generativelanguage.googleapis.com/v1beta</defaultValue>
        </input-field>

        <input-field type="int">
            <name>aiMaxTokens</name>
            <label>Max tokens</label>
            <label lang="de-DE">Maximale Tokens</label>
            <defaultValue>600</defaultValue>
        </input-field>

        <input-field type="float">
            <name>aiTemperature</name>
            <label>Temperature</label>
            <label lang="de-DE">Temperatur</label>
            <defaultValue>0.2</defaultValue>
        </input-field>

        <input-field type="int">
            <name>aiTimeout</name>
            <label>Timeout (seconds)</label>
            <label lang="de-DE">Timeout (Sekunden)</label>
            <defaultValue>20</defaultValue>
        </input-field>
    </card>
</config>
